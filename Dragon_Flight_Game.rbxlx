      <Item class="Script" referent="RBX6F80CD56F7B143EF">
        <Properties>
          <string name="Name">DragonGameServer</string>
          <ProtectedString name="Source">
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local remote = Instance.new("RemoteEvent")
remote.Name = "DragonControl"
remote.Parent = ReplicatedStorage

local dragons = {}
local controls = {}
local lastFire = {}

local function makePart(model, name, size, color, cf, shape)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Color = color
    p.Material = Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    if shape then p.Shape = shape end
    p.CFrame = cf
    p.Parent = model
    return p
end

local function createDragon(player)
    local model = Instance.new("Model")
    model.Name = player.Name .. "_Dragon"
    local root = makePart(model, "DragonRoot", Vector3.new(3, 2, 6), Color3.fromRGB(40, 150, 95), CFrame.new(0, 15, 0))
    model.PrimaryPart = root
    local green = Color3.fromRGB(35, 160, 105)
    local dark = Color3.fromRGB(25, 105, 80)
    makePart(model, "Body", Vector3.new(4, 3, 8), green, root.CFrame)
    makePart(model, "Head", Vector3.new(3, 2.5, 3), green, root.CFrame * CFrame.new(0, 1, -5))
    makePart(model, "Snout", Vector3.new(2.4, 1.2, 2), dark, root.CFrame * CFrame.new(0, 0.5, -7))
    makePart(model, "LeftWing", Vector3.new(8, 0.35, 4), dark, root.CFrame * CFrame.new(-5, 1, 0))
    makePart(model, "RightWing", Vector3.new(8, 0.35, 4), dark, root.CFrame * CFrame.new(5, 1, 0))
    makePart(model, "Tail", Vector3.new(1.2, 1.2, 6), green, root.CFrame * CFrame.new(0, 0, 6))
    makePart(model, "LeftHorn", Vector3.new(0.5, 1.6, 0.5), Color3.fromRGB(235, 205, 120), root.CFrame * CFrame.new(-0.9, 2.8, -5))
    makePart(model, "RightHorn", Vector3.new(0.5, 1.6, 0.5), Color3.fromRGB(235, 205, 120), root.CFrame * CFrame.new(0.9, 2.8, -5))
    for _, obj in ipairs(model:GetChildren()) do
        if obj:IsA("BasePart") and obj ~= root then
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = root
            weld.Part1 = obj
            weld.Parent = root
        end
    end
    model.Parent = workspace
    model:PivotTo(CFrame.new(0, 18, 0))
    return model
end

local function makeWorld()
    local floor = Instance.new("Part")
    floor.Name = "DragonIsle"
    floor.Size = Vector3.new(500, 4, 500)
    floor.Position = Vector3.new(0, -4, 0)
    floor.Anchored = true
    floor.Material = Enum.Material.Grass
    floor.Color = Color3.fromRGB(70, 145, 75)
    floor.Parent = workspace

    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "IslandSpawn"
    spawn.Size = Vector3.new(12, 1, 12)
    spawn.Position = Vector3.new(0, 0, 35)
    spawn.Anchored = true
    spawn.Neutral = true
    spawn.Parent = workspace

    for i = 1, 12 do
        local rock = Instance.new("Part")
        rock.Name = "FloatingRock"
        rock.Shape = Enum.PartType.Ball
        rock.Size = Vector3.new(math.random(12, 25), math.random(8, 16), math.random(12, 25))
        rock.Position = Vector3.new(math.random(-210, 210), math.random(25, 100), math.random(-210, 210))
        rock.Anchored = true
        rock.Material = Enum.Material.Slate
        rock.Color = Color3.fromRGB(95, 100, 110)
        rock.Parent = workspace
    end
end
makeWorld()

Players.PlayerAdded:Connect(function(player)
    local dragon = createDragon(player)
    dragons[player] = dragon
    controls[player] = {forward=0, back=0, left=0, right=0, up=0, down=0}
    player.CharacterAdded:Connect(function()
        task.wait(1)
        local root = dragon and dragon:FindFirstChild("DragonRoot")
        if root then
            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 0 end
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    if dragons[player] then dragons[player]:Destroy() end
    dragons[player], controls[player], lastFire[player] = nil, nil, nil
end)

remote.OnServerEvent:Connect(function(player, action, data)
    if action == "move" and typeof(data) == "table" then
        controls[player] = data
    elseif action == "fire" then
        local now = os.clock()
        if now - (lastFire[player] or 0) &lt; 5 then return end
        lastFire[player] = now
        local dragon = dragons[player]
        local root = dragon and dragon.PrimaryPart
        if root then
            local flame = Instance.new("Part")
            flame.Name = "DragonFireball"
            flame.Shape = Enum.PartType.Ball
            flame.Size = Vector3.new(3, 3, 3)
            flame.Material = Enum.Material.Neon
            flame.Color = Color3.fromRGB(255, 105, 20)
            flame.Anchored = true
            flame.CanCollide = false
            flame.CFrame = root.CFrame * CFrame.new(0, 0, -8)
            flame.Parent = workspace
            task.spawn(function()
                for n = 1, 35 do
                    if not flame.Parent then break end
                    flame.CFrame = flame.CFrame * CFrame.new(0, 0, -3)
                    flame.Size = flame.Size * 0.985
                    task.wait(0.035)
                end
                if flame.Parent then flame:Destroy() end
            end)
        end
    end
end)

RunService.Heartbeat:Connect(function(dt)
    for player, dragon in pairs(dragons) do
        local root = dragon and dragon.PrimaryPart
        local c = controls[player]
        if root and c then
            local forward = (tonumber(c.forward) or 0) - (tonumber(c.back) or 0)
            local side = (tonumber(c.right) or 0) - (tonumber(c.left) or 0)
            local vertical = (tonumber(c.up) or 0) - (tonumber(c.down) or 0)
            local cf = root.CFrame
            local move = cf.LookVector * forward + cf.RightVector * side + Vector3.new(0, vertical, 0)
            if move.Magnitude &gt; 0 then
                local direction = move.Unit
                local pos = root.Position + direction * 42 * dt
                local face = CFrame.lookAt(pos, pos + Vector3.new(direction.X, direction.Y * 0.35, direction.Z))
                dragon:PivotTo(face)
            end
        end
    end
end)
</ProtectedString>
