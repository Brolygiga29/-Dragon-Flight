        <Item class="LocalScript" referent="RBXE887161113454223">
          <Properties>
            <string name="Name">DragonFlightClient</string>
            <ProtectedString name="Source">
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("DragonControl")
local gui = Instance.new("ScreenGui")
gui.Name = "DragonFlightHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local state = {forward=0, back=0, left=0, right=0, up=0, down=0}
local function send()
    remote:FireServer("move", state)
end

local function makeButton(label, pos, size, key)
    local b = Instance.new("TextButton")
    b.Name = key .. "Button"
    b.Text = label
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = Color3.fromRGB(25, 65, 75)
    b.BackgroundTransparency = 0.12
    b.TextColor3 = Color3.new(1,1,1)
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.Parent = gui
    b.AutoButtonColor = true
    b.MouseButton1Down:Connect(function() state[key] = 1; send() end)
    b.MouseButton1Up:Connect(function() state[key] = 0; send() end)
    b.TouchLongPress:Connect(function(_, inputState)
        if inputState == Enum.UserInputState.End then state[key] = 0; send() end
    end)
    return b
end

local function button(text, x, y, key)
    return makeButton(text, UDim2.new(x,0,y,0), UDim2.new(0,76,0,62), key)
end

local title = Instance.new("TextLabel")
title.Size = UDim2.new(0, 260, 0, 38)
title.Position = UDim2.new(0.5, -130, 0, 12)
title.BackgroundTransparency = 0.25
title.BackgroundColor3 = Color3.fromRGB(15,35,40)
title.TextColor3 = Color3.new(1,1,1)
title.Text = "DRAGON FLIGHT  •  ¡Explora la isla!"
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = gui

local forward = button("▲", 0.08, 0.72, "forward")
local back = button("▼", 0.08, 0.86, "back")
local left = button("◀", 0.01, 0.79, "left")
local right = button("▶", 0.15, 0.79, "right")
local up = button("SUBIR", 0.77, 0.68, "up")
local down = button("BAJAR", 0.77, 0.82, "down")

local fire = Instance.new("TextButton")
fire.Name = "FireButton"
fire.Size = UDim2.new(0, 112, 0, 70)
fire.Position = UDim2.new(0.83, -56, 0.48, 0)
fire.BackgroundColor3 = Color3.fromRGB(190, 65, 20)
fire.TextColor3 = Color3.new(1,1,1)
fire.Font = Enum.Font.GothamBold
fire.TextScaled = true
fire.Text = "🔥 FUEGO"
fire.Parent = gui

local cooling = false
fire.Activated:Connect(function()
    if cooling then return end
    cooling = true
    remote:FireServer("fire")
    for n = 5, 1, -1 do
        fire.Text = "RECARGA " .. n .. "s"
        task.wait(1)
    end
    fire.Text = "🔥 FUEGO"
    cooling = false
end)

local keyMap = {
    [Enum.KeyCode.W]="forward", [Enum.KeyCode.S]="back",
    [Enum.KeyCode.A]="left", [Enum.KeyCode.D]="right",
    [Enum.KeyCode.Space]="up", [Enum.KeyCode.LeftControl]="down"
}
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    local key = keyMap[input.KeyCode]
    if key then state[key] = 1; send() end
    if input.KeyCode == Enum.KeyCode.F then fire:Activate() end
end)
UserInputService.InputEnded:Connect(function(input)
    local key = keyMap[input.KeyCode]
    if key then state[key] = 0; send() end
end)

local function attachCamera()
    local dragon = workspace:WaitForChild(player.Name .. "_Dragon", 15)
    if dragon and dragon.PrimaryPart then
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        workspace.CurrentCamera.CameraSubject = dragon.PrimaryPart
    end
end
task.spawn(attachCamera)

-- Keep the server updated if a touch button remains held.
RunService.Heartbeat:Connect(function()
    if UserInputService.TouchEnabled then send() end
end)
